{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profilePublic": { ".read": "auth != null" },
        "photo":         { ".read": "auth != null" },
        "todos":         { ".read": "auth != null" },
        "todoPublic":    { ".read": "auth != null" },
        "friends":    { ".read": "auth != null", "$fid": { ".write": "auth != null && (auth.uid === $uid || auth.uid === $fid)" } },
        "friendReqs": { ".read": "auth != null", "$fid": { ".write": "auth != null && (auth.uid === $uid || auth.uid === $fid)" } },
        "homeLikes":  { ".read": "auth != null", "$visitor": { ".write": "auth != null && auth.uid === $visitor" } },
        "mailbox": {
          "$sender": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $sender && root.child('users').child($uid).child('friends').child(auth.uid).exists()))",
            "$gid": {
              ".validate": "newData.hasChildren(['type','qty','from']) && newData.child('from').val() === auth.uid && newData.child('qty').isNumber() && ((newData.child('type').val() === 'gold' && newData.child('qty').val() === 1) || (newData.child('type').val() === 'coins' && newData.child('qty').val() > 0 && newData.child('qty').val() <= 10) || (newData.child('type').val() === 'consum' && newData.child('qty').val() > 0 && newData.child('qty').val() <= 3 && (newData.child('key').val() === 'egg' || newData.child('key').val() === 'water' || newData.child('key').val() === 'food')))"
            }
          }
        }
      }
    },

    "homeCam": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },

    "codes": {
      ".read": "auth != null",
      "$code": { ".write": "auth != null" }
    },

    "friendCodes": {
      ".read": "auth != null",
      "$code": { ".write": "auth != null" }
    },

    "migrationV3": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "rankings": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },

    "catalogPets": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null && auth.token.email === 'canel94@gmail.com'" }
    },

    "catalogPetArt": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null && auth.token.email === 'canel94@gmail.com'" }
    },

    "workspaces": {
      ".read": "auth != null",
      "$wsId": {
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).exists())"
      }
    },

    "ws": {
      "$wsId": {
        ".read":  "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()"
      }
    },

    "accounts":         { ".read": "auth != null", ".write": "auth != null" },
    "creditCards":      { ".read": "auth != null", ".write": "auth != null" },
    "categories":       { ".read": "auth != null", ".write": "auth != null" },
    "budgets":          { ".read": "auth != null", ".write": "auth != null" },
    "subscriptions":    { ".read": "auth != null", ".write": "auth != null" },
    "purposeBooks":     { ".read": "auth != null", ".write": "auth != null" },
    "people":           { ".read": "auth != null", ".write": "auth != null" },
    "giftEvents":       { ".read": "auth != null", ".write": "auth != null" },
    "plannedGiftEvents":{ ".read": "auth != null", ".write": "auth != null" },
    "transactions":     { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "savings":          { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "recurring":        { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "recurringLogs":    { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "fixedExpenses":    { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "settlementPayments": { ".read": "auth != null", "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "loans":            { ".read": "auth != null", ".write": "auth != null" },
    "loanPayments":     { ".read": "auth != null", ".write": "auth != null" }
  }
}
