{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'canel94@gmail.com'",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profilePublic": { ".read": "auth != null" },
        "photo":         { ".read": "auth != null" },
        "todos":         { ".read": "auth != null" },
        "todoPublic":    { ".read": "auth != null" },
        "todoShare":     { ".read": "auth != null" },
        "friends":    { ".read": "auth != null", "$fid": { ".write": "auth != null && (auth.uid === $uid || auth.uid === $fid)" } },
        "friendReqs": { ".read": "auth != null", "$fid": { ".write": "auth != null && (auth.uid === $uid || auth.uid === $fid)" } },
        "homeLikes":  { ".read": "auth != null", "$visitor": { ".write": "auth != null && auth.uid === $visitor" } },
        "mailbox": {
          "$sender": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $sender && root.child('users').child($uid).child('friends').child(auth.uid).exists()))",
            "$gid": {
              ".validate": "newData.hasChildren(['type','qty','from']) && newData.child('from').val() === auth.uid && newData.child('qty').isNumber() && ((newData.child('type').val() === 'coins' && newData.child('qty').val() > 0 && newData.child('qty').val() <= 10) || (newData.child('type').val() === 'consum' && newData.child('qty').val() > 0 && newData.child('qty').val() <= 3 && (newData.child('key').val() === 'egg' || newData.child('key').val() === 'water' || newData.child('key').val() === 'food')))"
            }
          }
        },
        "adminGifts": { ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'canel94@gmail.com')" }
      }
    },

    "homeCam": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },

    "presence": {
      ".read": "auth != null && auth.token.email === 'canel94@gmail.com'",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },

    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && root.child('workspaces').child(data.val()).child('members').child(auth.uid).child('role').val() === 'owner'))"
      }
    },

    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    },

    "migrationV3": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "rankings": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },

    "catalogPets": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null && auth.token.email === 'canel94@gmail.com'" }
    },

    "catalogPetArt": {
      ".read": "auth != null",
      "$id": { ".write": "auth != null && auth.token.email === 'canel94@gmail.com'" }
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'canel94@gmail.com'"
    },

    "workspaces": {
      "$wsId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists())",
        "members": {
          "$mid": {
            ".write": "auth != null && $mid === auth.uid && (!newData.exists() || (!data.exists() && newData.child('viaCode').val() === data.parent().parent().child('code').val() && root.child('codes').child(newData.child('viaCode').val()).val() === $wsId))"
          }
        }
      }
    },

    "ws": {
      "$wsId": {
        ".read":  "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()"
      }
    }
  }
}
